{
  "uid": "coupon-local-monitoring",
  "title": "Coupon Local Monitoring",
  "tags": ["coupon", "spring", "mysql", "redis", "local"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"coupon-toy-project\"}[1m])) by (method, uri, status)",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Latency p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"coupon-toy-project\"}[1m])) by (le, method, uri))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Application CPU",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"coupon-toy-project\"}",
          "legendFormat": "process"
        },
        {
          "expr": "system_cpu_usage{application=\"coupon-toy-project\"}",
          "legendFormat": "system"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM Memory",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"coupon-toy-project\"}) by (area)",
          "legendFormat": "{{area}} used"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tomcat Threads",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "expr": "tomcat_threads_busy_threads{application=\"coupon-toy-project\"}",
          "legendFormat": "busy"
        },
        {
          "expr": "tomcat_threads_config_max_threads{application=\"coupon-toy-project\"}",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 6,
      "title": "Hikari Connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"coupon-toy-project\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"coupon-toy-project\"}",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"coupon-toy-project\"}",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 7,
      "title": "MySQL Activity",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "threads connected"
        },
        {
          "expr": "rate(mysql_global_status_questions[1m])",
          "legendFormat": "questions/s"
        },
        {
          "expr": "rate(mysql_global_status_innodb_row_lock_waits[1m])",
          "legendFormat": "row lock waits/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Container CPU",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"coupon-.*\"}[1m])) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Container Memory",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"coupon-.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Redis",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "commands/s"
        },
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients"
        }
      ]
    },
    {
      "id": 11,
      "title": "Redis Memory",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 12,
      "title": "Coupon Issue Results",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [
        {
          "expr": "sum(rate(coupon_issue_requests_total[1m])) by (strategy, result)",
          "legendFormat": "{{strategy}} {{result}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Coupon Issue Latency p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(coupon_issue_duration_seconds_bucket[1m])) by (le, strategy))",
          "legendFormat": "{{strategy}} total"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(coupon_issue_db_duration_seconds_bucket[1m])) by (le, strategy))",
          "legendFormat": "{{strategy}} db"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(coupon_issue_redis_duration_seconds_bucket[1m])) by (le, strategy))",
          "legendFormat": "{{strategy}} redis"
        }
      ]
    },
    {
      "id": 14,
      "title": "Coupon Event Backlog",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "expr": "coupon_issue_event_inflight",
          "legendFormat": "inflight"
        },
        {
          "expr": "rate(coupon_issue_event_published_total[1m])",
          "legendFormat": "published/s"
        },
        {
          "expr": "rate(coupon_issue_event_completed_total[1m])",
          "legendFormat": "completed/s"
        },
        {
          "expr": "rate(coupon_issue_event_failed_total[1m])",
          "legendFormat": "failed/s"
        }
      ]
    },
    {
      "id": 15,
      "title": "Coupon Event Consistency Lag p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(coupon_issue_consistency_lag_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 lag"
        }
      ]
    }
  ]
}
